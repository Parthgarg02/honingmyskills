---
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const { title, description = SITE.description, image, type = 'website', publishedTime } = Astro.props;

const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';

const nav = [
  { label: 'Latest', href: '/' },
  { label: 'Archive', href: '/archive' },
  { label: 'Topics', href: '/topics' },
  { label: 'About', href: '/about' },
];
const isCurrent = (href: string) => (href === '/' ? isHome : path === href || path.startsWith(`${href}/`));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#f2ede0" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="wrap">
      <div class="strip">
        <span>Est. {SITE.established}</span>
        <span>{SITE.location}</span>
        <a href={SITE.subscribeUrl} rel="noopener">Subscribe by email</a>
      </div>

      <header class="masthead">
        {
          isHome ? (
            <h1 class="title">{SITE.title}</h1>
          ) : (
            <a class="title" href="/">
              {SITE.title}
            </a>
          )
        }
        <p class="tagline">{SITE.tagline}</p>
      </header>
      <nav class="nav" aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>

      <main id="main">
        <slot />
      </main>

      <footer class="footer">
        <div>© {SITE.title} {SITE.established}–{new Date().getFullYear()} · Written by {SITE.author} · Made with love in Lucknow</div>
        <div class="links">
          {SITE.social.map((s) => (
            <a href={s.href} rel="noopener me">
              {s.label}
            </a>
          ))}
          <a href="/rss.xml">RSS</a>
        </div>
      </footer>
    </div>
  </body>
</html>
