---
import { SITE } from '../consts';
---

<section class="subscribe" aria-labelledby="subscribe-heading">
  <div class="pitch">
    <strong id="subscribe-heading">Delivered when it is published.</strong>
    <span>Join the mailing list for new posts.</span>
  </div>
  <div class="action">
    <a class="button" href={SITE.subscribeUrl} rel="noopener">Subscribe by email</a>
  </div>
</section>
