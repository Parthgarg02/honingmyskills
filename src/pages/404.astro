---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="article">
    <header class="article-head">
      <div class="kicker">404</div>
      <h1>That page is not in this edition.</h1>
      <p class="description">It may have moved when the blog changed home. Try the archive.</p>
      <a class="more-link" href="/archive">Browse the archive</a>
    </header>
  </div>
</Base>
